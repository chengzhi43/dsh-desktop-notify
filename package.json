{
  "name": "dsh-desktop-notify",
  "version": "1.1.0",
  "description": "Desktop notifications for DeepSeek Harness: a banner when a turn finishes or the agent needs your choice, a click to return to that conversation, and unread ones counted on the app icon",
  "license": "MIT",
  "author": "chengzhi43",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "notification",
    "desktop",
    "system-notification"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhi43/dsh-desktop-notify.git"
  },
  "bugs": {
    "url": "https://github.com/chengzhi43/dsh-desktop-notify/issues"
  },
  "homepage": "https://github.com/chengzhi43/dsh-desktop-notify#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs",
    "screenshots.json",
    "README_CN.md",
    "CHANGELOG.md",
    "index.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
